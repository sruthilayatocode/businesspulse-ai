# Gemini is optional for the seeded demo, but required for live AI analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# sqlite runs the demo locally. Set to exasol for the Exasol deployment.
DATABASE_BACKEND=sqlite
SQLITE_PATH=data/businesspulse.db

# Required only when DATABASE_BACKEND=exasol
EXASOL_DSN=host:8563
EXASOL_USER=businesspulse_app
EXASOL_PASSWORD=
EXASOL_SCHEMA=BUSINESSPULSE
